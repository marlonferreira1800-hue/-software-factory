# ==========================================================
# Fábrica Livre — Variáveis de Ambiente
# Copie este arquivo para ".env" antes de rodar localmente.
# ==========================================================

# Banco de dados PostgreSQL
POSTGRES_USER=fabrica
POSTGRES_PASSWORD=fabrica_dev_password
POSTGRES_DB=fabrica_livre
DATABASE_URL="postgresql://fabrica:fabrica_dev_password@localhost:5432/fabrica_livre?schema=public"

# Autenticação JWT & Criptografia (troque em produção!)
JWT_SECRET="fabrica-livre-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
ENCRYPTION_SECRET="fabrica-livre-aes-256-key-change-in-production-2026"

# API Backend (NestJS)
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://api:3001"

# Opcional: chaves globais de IA (os usuários também podem configurar via interface ou usar assinaturas sem chave)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
